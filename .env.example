# Firebase Configuration (from Firebase Console)
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-xxxxx
VITE_FIREBASE_STORAGE_BUCKET=your-project-xxxxx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=0000000000
VITE_FIREBASE_APP_ID=1:0000000000:web:xxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_FIRESTORE_DB_ID=your-firestore-db-xxxxx
VITE_FIREBASE_OAUTH_CLIENT_ID=0000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Error Tracking & Monitoring (Sentry DSN - optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Feature Flags & Configuration
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_LOG_LEVEL=info

# Note: Never commit actual secrets. Use GitHub Secrets or CI/CD secrets manager.
