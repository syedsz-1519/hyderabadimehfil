rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'syed.sz.2126@gmail.com';
    }

    function isValidReview(data) {
      return data.keys().hasAll(['authorUid', 'name', 'subtitle', 'stars', 'quote', 'createdAt'])
        && data.keys().hasOnly(['authorUid', 'name', 'subtitle', 'stars', 'quote', 'createdAt'])
        && data.authorUid is string
        && data.authorUid.size() > 0
        && data.authorUid.size() <= 128
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 60
        && data.subtitle is string
        && data.subtitle.size() >= 2
        && data.subtitle.size() <= 60
        && data.stars is int
        && data.stars >= 1
        && data.stars <= 5
        && data.quote is string
        && data.quote.size() >= 10
        && data.quote.size() <= 500
        && data.createdAt is timestamp;
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'subtitle', 'stars', 'quote']);
      allow delete: if isVerifiedUser()
        && isValidId(reviewId)
        && (existing().authorUid == request.auth.uid || isBootstrappedAdmin());
    }
  }
}
